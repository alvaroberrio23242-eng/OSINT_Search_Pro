# Copia este archivo como .env y rellena solo las claves que tengas.
# Ninguna es obligatoria: sin ellas, la plataforma funciona igual con fuentes gratuitas.

SECRET_KEY=cambia-esto-en-produccion

# --- Brave Search API (recomendado) ---
# Gratis hasta 2000 consultas/mes: https://api.search.brave.com/register
# Con esta clave, el motor "Brave Search" trae resultados REALES y no se
# bloquea en hosting (Render/Railway), a diferencia del resto de motores
# que hacen scraping y sí suelen bloquearse desde IPs de datacenter.
BRAVE_API_KEY=

# --- Google Custom Search JSON API (recomendado, gratis 100/día) ---
# 1) Crea un "Programmable Search Engine" en https://programmablesearchengine.google.com/
#    (actívalo para "buscar en toda la web") y copia su ID -> GOOGLE_CSE_ID
# 2) Crea una API key en https://console.cloud.google.com/apis/credentials
#    y habilita "Custom Search API" en ese proyecto -> GOOGLE_API_KEY
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Integraciones opcionales (no incluidas en la v2.0 por defecto) ---
HUNTER_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
HIBP_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SECURITYTRAILS_API_KEY=
